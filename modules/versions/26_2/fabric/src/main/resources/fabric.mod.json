{
  "schemaVersion": 1,
  "id": "photonics",
  "version": "${photonics_version}+${minecraft_version}",
  "name": "Photonics",
  "description": "An Iris raytracing extension. Community fork of Photonics by Redi2Go and Essentuan, adding Minecraft 26.2 support.",
  "authors": [
    "Redi2Go", "Essentuan"
  ],
  "contributors": [
    "Kaede"
  ],
  "contact": {
    "sources": "https://github.com/Kaede-Eves/PhotonicEngine",
    "homepage": "https://github.com/Redi2Go/PhotonicEngine"
  },
  "license": "LGPL-3.0-only",
  "icon": "assets/photonics/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "at.redi2go.photonics.client.PhotonicsClientFabric"
    ]
  },
  "mixins": [
    "photonics-common.mixins.json",
    "photonics-common-impl.mixins.json",
    "photonics-fabric.mixins.json",
    "photonics-fabric-impl.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=17"
  }
}